{
  "pluginAlias": "BetterKey",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": true,
  "schema": {
    "type": "object",
    "required": ["name", "apiKey"],
    "additionalProperties": false,
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "BetterKey"
      },
      "apiKey": {
        "title": "BetterKey API Key",
        "type": "string",
        "minLength": 12,
        "placeholder": "bk_…"
      },
      "pollIntervalSeconds": {
        "title": "Poll Interval (seconds)",
        "type": "integer",
        "default": 60,
        "minimum": 30,
        "maximum": 600
      },
      "verboseLogging": {
        "title": "Verbose Logging",
        "type": "boolean",
        "default": false
      }
    }
  }
}
